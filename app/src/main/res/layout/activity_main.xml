<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ===== 고정 헤더 ===== -->
    <LinearLayout
        android:id="@+id/header_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#757575"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:elevation="6dp">

        <TextView
            android:id="@+id/tv_header_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="서로지킴 - 꺼짐"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/tv_header_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="설정을 저장하면 시작됩니다"
            android:textColor="#EEEEEE"
            android:textSize="12sp"
            android:gravity="center"
            android:paddingTop="2dp" />

    </LinearLayout>

    <!-- ===== 스크롤 영역 ===== -->
    <ScrollView
        android:id="@+id/scroll_root"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="우리가 서로를 지켜주는 보이스피싱 안전망"
                android:textSize="13sp"
                android:textColor="#888888"
                android:paddingBottom="16dp" />

            <TextView
                android:id="@+id/tv_status_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:textSize="13sp"
                android:background="#EEEEEE"
                android:textColor="#333333"
                android:text="설정을 저장하면 서로 지켜보기가 시작됩니다." />

            <TextView
                android:id="@+id/tv_permission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:textSize="13sp"
                android:background="#FFF3E0"
                android:textColor="#333333"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:text="권한 확인 중..." />

            <Button
                android:id="@+id/btn_perm_overlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="① 다른 앱 위에 표시 권한" />

            <Button
                android:id="@+id/btn_perm_alarm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="② 알람 및 리마인더 권한" />

            <Button
                android:id="@+id/btn_perm_battery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="20dp"
                android:text="③ 배터리 최적화 해제" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="내 이름"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="보호자에게 보낼 문자에 표시됩니다."
                android:textSize="12sp"
                android:textColor="#888888" />

            <EditText
                android:id="@+id/et_my_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:hint="예: 김철수" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1차 알림 (나에게만)"
                android:textStyle="bold"
                android:paddingTop="20dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/et_first_min"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:hint="분" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="분"
                    android:paddingLeft="4dp"
                    android:paddingRight="12dp"
                    android:gravity="center_vertical" />

                <EditText
                    android:id="@+id/et_first_sec"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:hint="초" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="초"
                    android:paddingLeft="4dp"
                    android:gravity="center_vertical" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2차 경고 (보호자에게 알림)"
                android:textStyle="bold"
                android:paddingTop="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/et_second_min"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:hint="분" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="분"
                    android:paddingLeft="4dp"
                    android:paddingRight="12dp"
                    android:gravity="center_vertical" />

                <EditText
                    android:id="@+id/et_second_sec"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:hint="초" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="초"
                    android:paddingLeft="4dp"
                    android:gravity="center_vertical" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="나를 지켜줄 보호자 (최대 3명)"
                android:textStyle="bold"
                android:paddingTop="20dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="이 번호들은 통화 감시에서 자동으로 제외됩니다."
                android:textSize="12sp"
                android:textColor="#888888" />

            <EditText
                android:id="@+id/et_guardian1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="phone"
                android:hint="보호자 1 (필수)" />

            <EditText
                android:id="@+id/et_guardian2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="phone"
                android:hint="보호자 2 (선택)" />

            <EditText
                android:id="@+id/et_guardian3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="phone"
                android:hint="보호자 3 (선택)" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:layout_marginTop="12dp"
                android:background="#E8F5E9"
                android:textColor="#1B5E20"
                android:textSize="13sp"
                android:lineSpacingExtra="4dp"
                android:text="통화가 설정 시간을 넘기면 설정된 보호자에게 알림이 자동 발송됩니다. 또한 이 번호에서 걸려온 전화는 감시하지 않습니다.\n\n보호자에게도 앱을 설치하고 나를 보호자로 등록해 달라고 하세요. 서로 지켜주는 것이 가장 안전합니다." />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="그 밖의 예외 번호 (콤마로 구분)"
                android:textStyle="bold"
                android:paddingTop="20dp" />

            <EditText
                android:id="@+id/et_whitelist_numbers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="phone"
                android:hint="예: 021234567,0312345678" />

            <Button
                android:id="@+id/btn_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="저장하고 시작하기" />

            <Button
                android:id="@+id/btn_test_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="경고 화면 테스트" />

            <Button
                android:id="@+id/btn_test_sms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp"
                android:text="보호자 문자 테스트" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
